{
  "$schema": "https://nixpacks.com/config.json",
  "providers": ["php", "node"],
  "phases": {
    "setup": {
      "nixPkgs": ["php82", "php82Extensions.gd", "php82Extensions.pdo_mysql", "php82Extensions.mbstring", "composer", "nodejs"]
    },
    "install": {
      "cmds": ["composer install --no-dev --optimize-autoloader --no-interaction"]
    },
    "build": {
      "cmds": [
        "php artisan config:clear",
        "php artisan route:clear",
        "php artisan view:clear"
      ]
    }
  },
  "start": {
    "cmd": "php artisan serve --host=0.0.0.0 --port=$PORT"
  }
}
